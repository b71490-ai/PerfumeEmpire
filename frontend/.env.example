# Frontend environment example
# Use only NEXT_PUBLIC_API_URL for backend origin
NEXT_PUBLIC_API_URL=https://api.perfumeempire.example

# Middleware JWT validation (server-side only in Next)
JWT_KEY=replace-with-same-jwt-key-used-by-backend
JWT_ISSUER=https://api.perfumeempire.example
JWT_AUDIENCE=perfume-frontend

# Optional test credentials for E2E scripts
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=replace-with-strong-password
